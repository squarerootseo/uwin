---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "Badminton Court Flooring: BWF-Grade PVC & Wooden Systems | India"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://uwinfloortech.com"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Sports",
        "item": "https://uwinfloortech.com/sports"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "Badminton Court Flooring"
      }
    ]
  }
]);
---

<Layout title="Badminton Court Flooring: BWF-Grade PVC & Wooden Systems | India" description="Professional badminton court flooring. Compare Canadian Maple wooden flooring and high-performance PVC vinyl. Direct manufacturer pricing and installation." schema={schema}>
  <Navbar />
  
  <section class="product-hero" aria-label="Badminton Court Flooring hero">
    <div class="product-hero__img-wrap">
      <img src="/images/hero-badminton-court.jpg" alt="Badminton Court Flooring" class="product-hero__img" />
      <div class="product-hero__overlay"></div>
    </div>
    <div class="product-hero__content">
      <div class="product-hero__inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">›</span>
        <a href="/#sports">Sports</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">Badminton Court Flooring</span>
      </nav>
      <span class="product-hero__eyebrow">Indoor Sports Solutions</span>
      <h1 class="product-hero__title">Badminton Court<br/>Flooring</h1>
      <p class="product-hero__sub">BWF-approved PVC vinyl and sprung wooden flooring systems for elite tournaments, commercial academies, and school gymnasiums across India.</p>
      <div class="product-hero__ctas">
        <a href="/contact" class="btn btn-primary btn-lg">Get a Quote</a>
        <a href="https://wa.me/919821648112" target="_blank" rel="noopener" class="btn btn-whatsapp btn-lg">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          WhatsApp Inquiry
        </a>
      </div>
      </div>
    </div>
  </section>

  <div class="spec-bar">
    <div class="container spec-bar__inner">
      <div class="spec-bar__item">
        <span class="spec-bar__label">Materials</span>
        <span class="spec-bar__value">PVC Vinyl (4.5mm+), Teakwood, Maple</span>
      </div>
      <div class="spec-bar__item">
        <span class="spec-bar__label">Applications</span>
        <span class="spec-bar__value">Indoor Sports Halls</span>
      </div>
      <div class="spec-bar__item">
        <span class="spec-bar__label">Certification</span>
        <span class="spec-bar__value">BWF Approved Options</span>
      </div>
      <div class="spec-bar__item">
        <span class="spec-bar__label">Key Benefit</span>
        <span class="spec-bar__value">Point-Elastic & Area-Elastic Shock Absorption</span>
      </div>
    </div>
  </div>

  <section class="section section--white">
    <div class="container product-overview">
      <div class="product-overview__text">
        <span class="section-eyebrow">The Challenge</span>
        <h2 class="h2">The Complete Guide to Badminton Court Flooring in India</h2>
        <span class="section-divider" aria-hidden="true"></span>
        <p class="snapshot">For commercial academies, 4.5mm PVC vinyl is the most cost-effective, high-performance option. For elite tournaments, a sprung wooden system (Teakwood or Maple) over an EPDM shock pad is the absolute gold standard.</p>
        <p>India is experiencing an unprecedented boom in badminton infrastructure. Selecting the correct surface is critical—badminton involves aggressive lateral movements and high-impact jump smashes that require specialized flooring to prevent knee and ankle injuries.</p>
      </div>
      <div class="product-overview__img">
        <img src="/images/hero-badminton-court.jpg" alt="Badminton Court Flooring Design" loading="lazy" style="border-radius:var(--card-radius); box-shadow:var(--shadow-md);" />
      </div>
    </div>
  </section>

  <section class="section section--surface">
    <div class="container">
      <div class="section-header reveal">
        <h2 class="h2">Professional Badminton Surfaces</h2>
        <span class="section-divider" aria-hidden="true"></span>
        <p class="snapshot">We supply and install the two primary flooring systems mandated for professional indoor badminton play.</p>
      </div>
      <div class="why-grid">
        <div class="why-card reveal">
          <div class="why-card__icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
          </div>
          <h3 class="why-card__title">PVC Vinyl Badminton Flooring</h3>
          <p>Engineered specifically for indoor sports with a multi-layer construction. We mandate a minimum thickness of 4.5mm to deliver point-elastic shock absorption, protecting joints during heavy landing.</p>
          <a href="/products/badminton-pvc-vinyl-sports-flooring" style="color:var(--color-primary); font-weight:600; margin-top:1rem; display:inline-block;">Learn More &rarr;</a>
        </div>
        <div class="why-card reveal reveal-delay-1">
          <div class="why-card__icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
          </div>
          <h3 class="why-card__title">Premium Wooden Systems</h3>
          <p>For BWF-affiliated clubs. Canadian Maple or Teakwood laid over EPDM rubber shock pads. This decoupled sprung floor provides unmatched area-elastic energy return.</p>
          <a href="/products/badminton-wooden-flooring" style="color:var(--color-primary); font-weight:600; margin-top:1rem; display:inline-block;">Learn More &rarr;</a>
        </div>
        <div class="why-card reveal reveal-delay-2">
          <div class="why-card__icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <h3 class="why-card__title">Turnkey Installation</h3>
          <p>We handle everything from sub-base leveling and moisture barriers to final court line marking. Direct manufacturer pricing with zero middlemen.</p>
          <a href="/contact" style="color:var(--color-primary); font-weight:600; margin-top:1rem; display:inline-block;">Learn More &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="container">
      <div class="section-header reveal">
        <h2 class="h2">Crucial Sub-Base Requirements</h2>
        <span class="section-divider" aria-hidden="true"></span>
        <p class="snapshot">Before laying PVC vinyl or wooden flooring, the sub-base must be perfectly leveled. Any undulations will telegraph through the vinyl or create dead spots in the wood.</p>
      </div>
      <div class="specs-table-wrap reveal">
        <table class="specs-table">
          <tbody>
            <tr>
              <td class="specs-table__key">Self-Leveling Compound</td>
              <td class="specs-table__val">Required on uneven concrete to create a glass-flat finish for PVC vinyl adherence.</td>
            </tr>
            <tr>
              <td class="specs-table__key">Moisture Barrier</td>
              <td class="specs-table__val">Critical for ground-floor installations to prevent rising dampness from warping the wooden structure or bubbling the vinyl.</td>
            </tr>
            <tr>
              <td class="specs-table__key">Anti-Termite Treatment</td>
              <td class="specs-table__val">Mandatory prior to laying the sleeper framework for any wooden sprung floor system.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section section--cta">
    <div class="container" style="text-align:center;">
      <h2 class="h2" style="color:#fff;">The UWIN Floortech Advantage</h2>
      <p style="color:rgba(255,255,255,0.8); max-width:600px; margin:1rem auto 2rem;">Buying sports flooring in India usually involves navigating a maze of middlemen who mark up prices by 25-40%. <strong>We eliminate the middleman.</strong> Get manufacturer-direct pricing and professional installation anywhere in India.</p>
      <div style="display:flex; gap:1rem; justify-content:center; flex-wrap:wrap;">
        <a href="/contact" class="btn btn-primary btn-lg" style="background:#fff; color:var(--color-primary);">Get a Free Quote</a>
        <a href="https://wa.me/919821648112" target="_blank" rel="noopener" class="btn btn-whatsapp btn-lg">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          WhatsApp Us Now
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .product-overview__text .section-divider { margin-left: 0; margin-right: auto; }
  .product-hero { position: relative; min-height: 580px; display: flex; align-items: flex-end; margin-top: var(--nav-height); }
  .product-hero__img-wrap { position: absolute; inset: 0; overflow: hidden; }
  .product-hero__img { width: 100%; height: 100%; object-fit: cover; object-position: center 40%; }
  .product-hero__overlay { position: absolute; inset: 0; background: linear-gradient(to right, rgba(10,30,55,0.85) 0%, rgba(10,30,55,0.55) 55%, rgba(10,30,55,0.1) 100%), linear-gradient(to top, rgba(10,30,55,0.6) 0%, transparent 60%); }
  .product-hero__content { text-align: left; position: relative; z-index: 2; padding-bottom: 56px; padding-top: 40px; width: 100%; max-width: var(--container-max, 1200px); margin: 0 auto; padding-left: var(--container-pad, 24px); padding-right: var(--container-pad, 24px); }
  .product-hero__inner { max-width: 620px; }
  .breadcrumb { display: flex; align-items: center; gap: 6px; font-size: 0.78rem; color: rgba(255,255,255,0.65); margin-bottom: 1rem; }
  .breadcrumb a { color: rgba(255,255,255,0.65); }
  .breadcrumb a:hover { color: var(--color-accent); }
  .product-hero__eyebrow { display: block; font-family: var(--font-heading); font-size: 0.78rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-accent); margin-bottom: 0.6rem; }
  .product-hero__title { font-family: var(--font-heading); font-size: clamp(2.2rem, 5vw, 3.6rem); font-weight: 800; color: #fff; line-height: 1.1; margin-bottom: 1rem; }
  .product-hero__sub { font-size: 1.05rem; color: rgba(255,255,255,0.82); max-width: 580px; line-height: 1.6; margin-bottom: 1.8rem; }
  .product-hero__ctas { justify-content: flex-start; display: flex; gap: 1rem; flex-wrap: wrap; }
  .spec-bar { background: var(--color-primary); padding: 0; }
  .spec-bar__inner { display: flex; flex-wrap: wrap; gap: 0; border-top: 1px solid rgba(255,255,255,0.1); }
  .spec-bar__item { flex: 1 1 180px; padding: 18px 20px; border-right: 1px solid rgba(255,255,255,0.1); display: flex; flex-direction: column; gap: 3px; }
  .spec-bar__item:last-child { border-right: none; }
  .spec-bar__label { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1em; color: rgba(255,255,255,0.55); font-weight: 600; }
  .spec-bar__value { font-size: 0.88rem; font-weight: 600; color: #fff; font-family: var(--font-heading); }
  .product-overview { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; }
  .product-overview__text p { color: var(--color-text-muted); line-height: 1.7; }
  .product-overview__tags { display: flex; flex-wrap: wrap; gap: 8px; }
  .product-overview__img img { border-radius: var(--card-radius); box-shadow: var(--shadow-lg); width: 100%; aspect-ratio: 4/3; object-fit: cover; }
  .why-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px,1fr)); gap: 24px; margin-top: 2rem; }
  .why-card { background: #fff; border: 1px solid var(--color-border); border-radius: var(--card-radius); padding: 28px; box-shadow: var(--shadow-sm); transition: box-shadow var(--transition-mid), transform var(--transition-mid); }
  .why-card:hover { box-shadow: var(--shadow-md); transform: translateY(-3px); }
  .why-card__icon { width: 52px; height: 52px; border-radius: 12px; background: rgba(91,190,15,0.08); display: flex; align-items: center; justify-content: center; margin-bottom: 16px; }
  .why-card__title { font-family: var(--font-heading); font-size: 1rem; font-weight: 700; color: var(--color-text); margin-bottom: 8px; }
  .why-card p { font-size: 0.88rem; color: var(--color-text-muted); line-height: 1.65; }
  .specs-table-wrap { border-radius: var(--card-radius); overflow: hidden; box-shadow: var(--shadow-md); border: 1px solid var(--color-border); }
  .specs-table { width: 100%; border-collapse: collapse; }
  .specs-table tr { border-bottom: 1px solid var(--color-border); }
  .specs-table tr:last-child { border-bottom: none; }
  .specs-table tr:nth-child(even) { background: var(--color-surface); }
  .specs-table__key { padding: 14px 20px; font-weight: 600; font-size: 0.85rem; color: var(--color-text); width: 35%; font-family: var(--font-heading); }
  .specs-table__val { padding: 14px 20px; font-size: 0.85rem; color: var(--color-text-muted); }
  .section--cta { background: linear-gradient(135deg, var(--color-primary-deep) 0%, var(--color-primary) 100%); padding: var(--section-pad); }
  @media (max-width: 768px) { .product-overview { grid-template-columns: 1fr; gap: 32px; } .product-overview__img { order: -1; } .spec-bar__item { flex: 1 1 140px; } }
</style>

<script>
  import '../../js/app.js';
</script>
