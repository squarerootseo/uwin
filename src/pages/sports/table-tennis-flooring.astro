---
import Layout from '../../layouts/Layout.astro';

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "Table Tennis Flooring",
    "description": "Professional table tennis flooring installation and surfacing solutions by U Win Floortech."
  }
]);
---

<Layout title="Table Tennis Flooring | UWIN Floortech" description="Professional table tennis flooring installation and surfacing solutions across India.">
  <main class="pt-24 pb-16 bg-white min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl md:text-5xl font-bold text-[#1E293B] mb-6">Table Tennis Flooring</h1>
      <p class="text-lg text-slate-600 mb-8">
        We provide turnkey table tennis flooring solutions, sourcing materials directly from manufacturers and installing them with expert crews. No middlemen, full accountability.
      </p>
      
      <div class="bg-blue-50 border border-blue-100 rounded-xl p-8 mb-12">
        <h2 class="text-2xl font-bold text-[#1E293B] mb-4">Content Pending</h2>
        <p class="text-slate-600">This page structure has been scaffolded per the new 3-Silo architecture and is scheduled for content population.</p>
      </div>
    </div>
  </main>
</Layout>
