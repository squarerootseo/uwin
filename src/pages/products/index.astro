---
import Navbar from '../../components/Navbar.astro';
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "Turnkey Sports Flooring Products & Surface Systems",
    "description": "UWIN Floortech's complete range of sports flooring surfaces including PP Interlocking Tiles, EPDM Tracks, Acrylic Courts, PVC Vinyl, Wooden Flooring, and Artificial Grass.",
    "brand": { "@type": "Brand", "name": "U WIN Floortech" }
  }
]);
---

<Layout 
  title="Sports Flooring Products & Surfaces | U WIN Floortech"
  description="Explore our 6 premium sports flooring surface systems including ITF-certified acrylic, PP tiles, EPDM tracks, PVC vinyl, wooden flooring, and artificial grass."
  schema={schema}
>
  <Navbar />

  <!-- ============================================================
       HERO SECTION
       ============================================================ -->
  <section class="products-hub-hero">
    <div class="products-hub-hero__overlay"></div>
    <div class="container products-hub-hero__content">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">Products</span>
      </nav>
      <span class="section-eyebrow" style="color:var(--color-accent); margin-bottom:1rem; display:block;">Our Portfolio</span>
      <h1 class="h1 text-white">Engineered Surface Systems</h1>
      <p class="hero-sub">Six premium product lines designed for every outdoor and indoor sports application. Certified materials, turnkey execution.</p>
    </div>
  </section>

  <!-- ============================================================
       PRODUCT GRID
       ============================================================ -->
  <section class="section section--white">
    <div class="container">
      
      <div class="product-grid">
        
        <!-- 1. PP Tiles -->
        <a href="/products/pp-interlocking-tiles" class="product-card reveal">
          <div class="product-card__img-wrap">
            <img src="/images/app-pp-tiles.png" alt="PP Interlocking Modular Tiles" class="product-card__img" loading="lazy" />
          </div>
          <div class="product-card__content">
            <h2 class="product-card__title">PP Interlocking Modular Tiles</h2>
            <p class="product-card__desc">UV-stabilised copolymer tiles that click together without adhesive. Self-draining and perfectly suited for outdoor multi-sport courts.</p>
            <span class="product-card__link">View Specifications <span>→</span></span>
          </div>
        </a>

        <!-- 2. EPDM -->
        <a href="/products/epdm-tracks-surfaces" class="product-card reveal reveal-delay-1">
          <div class="product-card__img-wrap">
            <img src="/images/hero-epdm.png" alt="EPDM Rubberised Tracks & Surfaces" class="product-card__img" loading="lazy" />
          </div>
          <div class="product-card__content">
            <h2 class="product-card__title">EPDM Tracks &amp; Surfaces</h2>
            <p class="product-card__desc">Virgin EPDM granules bonded with polyurethane. Seamless pour-in-place safety surface for athletic running tracks and play areas.</p>
            <span class="product-card__link">View Specifications <span>→</span></span>
          </div>
        </a>

        <!-- 3. Acrylic -->
        <a href="/products/acrylic-court-systems" class="product-card reveal reveal-delay-2">
          <div class="product-card__img-wrap">
            <img src="/images/hero-acrylic.png" alt="Acrylic Court Coating Systems" class="product-card__img" loading="lazy" />
          </div>
          <div class="product-card__content">
            <h2 class="product-card__title">Acrylic Court Systems</h2>
            <p class="product-card__desc">ITF pace-classified multi-layer synthetic coating systems applied over concrete or asphalt. The global standard for tennis courts.</p>
            <span class="product-card__link">View Specifications <span>→</span></span>
          </div>
        </a>

        <!-- 4. PVC Vinyl -->
        <a href="/products/badminton-pvc-vinyl-sports-flooring" class="product-card reveal">
          <div class="product-card__img-wrap">
            <img src="/images/badminton-pvc-vinyl-court.png" alt="Badminton PVC Vinyl Sports Flooring" class="product-card__img" loading="lazy" />
          </div>
          <div class="product-card__content">
            <h2 class="product-card__title">PVC Vinyl Sports Flooring</h2>
            <p class="product-card__desc">High-performance vinyl flooring designed specifically for indoor badminton. Excellent shock absorption and anti-slip properties.</p>
            <span class="product-card__link">View Specifications <span>→</span></span>
          </div>
        </a>

        <!-- 5. Wooden Flooring -->
        <a href="/products/badminton-wooden-flooring" class="product-card reveal reveal-delay-1">
          <div class="product-card__img-wrap">
            <img src="/images/badminton-wooden-floor-court.png" alt="Badminton Wooden Flooring" class="product-card__img" loading="lazy" />
          </div>
          <div class="product-card__content">
            <h2 class="product-card__title">Badminton Wooden Flooring</h2>
            <p class="product-card__desc">Premium Teakwood and Canadian Maple wood flooring for professional indoor arenas. Unmatched ball bounce and elasticity.</p>
            <span class="product-card__link">View Specifications <span>→</span></span>
          </div>
        </a>

        <!-- 6. Artificial Grass -->
        <a href="/products/sand-based-artificial-grass" class="product-card reveal reveal-delay-2">
          <div class="product-card__img-wrap">
            <img src="/images/app-synthetic-turf.png" alt="Sand Based Artificial Grass" class="product-card__img" loading="lazy" />
          </div>
          <div class="product-card__content">
            <h2 class="product-card__title">Sand-Based Artificial Grass</h2>
            <p class="product-card__desc">High-density synthetic turf system providing a natural feel, high durability, and exceptionally low maintenance.</p>
            <span class="product-card__link">View Specifications <span>→</span></span>
          </div>
        </a>

      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  /* ── Hero Section ── */
  .products-hub-hero {
    position: relative;
    background: url('/images/hero-acrylic.png') no-repeat center center;
    background-size: cover;
    min-height: 420px;
    display: flex;
    align-items: center;
    margin-top: var(--nav-height);
  }
  .products-hub-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(10,30,55,0.92) 0%, rgba(10,30,55,0.7) 100%);
  }
  .products-hub-hero__content {
    position: relative;
    z-index: 2;
    padding-top: 40px;
    padding-bottom: 40px;
  }
  .hero-sub {
    color: rgba(255,255,255,0.8);
    font-size: 1.15rem;
    max-width: 600px;
    margin-top: 1rem;
    line-height: 1.6;
  }
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.78rem;
    color: rgba(255,255,255,0.65);
    margin-bottom: 1.5rem;
  }
  .breadcrumb a { color: rgba(255,255,255,0.65); }
  .breadcrumb a:hover { color: var(--color-accent); }

  /* ── Product Grid ── */
  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 32px;
  }
  .product-card {
    background: #fff;
    border-radius: var(--card-radius);
    border: 1px solid var(--color-border);
    overflow: hidden;
    transition: all var(--transition-mid);
    display: flex;
    flex-direction: column;
    text-decoration: none;
  }
  .product-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-lg);
    border-color: rgba(13,92,147,0.15);
  }
  .product-card__img-wrap {
    width: 100%;
    height: 220px;
    overflow: hidden;
    position: relative;
  }
  .product-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .product-card:hover .product-card__img {
    transform: scale(1.05);
  }
  .product-card__content {
    padding: 24px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .product-card__title {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-primary-deep);
    margin-bottom: 12px;
  }
  .product-card__desc {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 24px;
    flex: 1;
  }
  .product-card__link {
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--color-primary);
    display: flex;
    align-items: center;
    gap: 6px;
    transition: color var(--transition-fast);
  }
  .product-card__link span {
    transition: transform var(--transition-fast);
  }
  .product-card:hover .product-card__link {
    color: var(--color-accent);
  }
  .product-card:hover .product-card__link span {
    transform: translateX(4px);
  }

  @media (max-width: 768px) {
    .product-grid { gap: 24px; }
  }
</style>

<script>
  import '../../js/app.js';
</script>
