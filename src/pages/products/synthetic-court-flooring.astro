    <div class="product-hero__img-wrap">
      <img src="/images/hero-synthetic-court.jpg" alt="High-end professional synthetic multi-sport court" class="product-hero__img" />
      <div class="product-hero__overlay"></div>
    </div>
    <div class="product-hero__content">
      <div class="product-hero__inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">›</span>
        <a href="/#products">Products</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">Synthetic Court Flooring</span>
      </nav>
      <span class="product-hero__eyebrow">Turnkey Sports Solutions</span>
      <h1 class="product-hero__title">Synthetic Court<br/>Flooring</h1>
      <p class="product-hero__sub">Turnkey, manufacturer-direct solutions for schools, premium clubs, and professional academies across India. We supply and install ITF-certified acrylic and BWF-grade PVC vinyl surfaces.</p>
      <div class="product-hero__ctas">
        <a href="/contact" class="btn btn-primary btn-lg">Get a Quote</a>
        <a href="https://wa.me/919821648112" target="_blank" rel="noopener" class="btn btn-whatsapp btn-lg">
