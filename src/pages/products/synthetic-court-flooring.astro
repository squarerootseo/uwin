---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "Synthetic Court Flooring"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://uwinfloortech.com"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Products",
        "item": "https://uwinfloortech.com/products"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "Synthetic Court Flooring"
      }
    ]
  }
]);
---

<Layout title="Synthetic Court Flooring: Turnkey Solutions for Schools & Clubs | UWIN Floortech" description="Upgrade to certified synthetic court flooring. We provide manufacturer-direct PVC vinyl, acrylic, and PP tiles for sports facilities across India. Get a quote." schema={schema}>
  <Navbar />
  
  <main class="bg-slate-50 min-h-screen">
    
    <!-- Hero Section with Background Image -->
    <section class="relative min-h-[70vh] flex items-center pt-20 overflow-hidden">
      <!-- Background Image -->
      <div class="absolute inset-0 z-0">
        <img 
          src="/images/hero-synthetic-court.jpg" 
          alt="Premium Synthetic Sports Court" 
          class="w-full h-full object-cover object-center"
        />
        <!-- Gradient Overlay for Readability -->
        <div class="absolute inset-0 bg-gradient-to-r from-slate-900/95 via-slate-900/80 to-transparent"></div>
      </div>

      <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
        <div class="max-w-3xl">
          <span class="inline-block py-1 px-3 rounded-full bg-blue-500/20 text-blue-300 text-sm font-semibold tracking-wider uppercase mb-6 border border-blue-500/30 backdrop-blur-sm">
            Professional Sports Surfaces
          </span>
          <h1 class="text-5xl md:text-7xl font-extrabold text-white leading-tight mb-6">
            Synthetic Court <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-emerald-400">Flooring</span>
          </h1>
          <p class="text-xl text-slate-300 mb-10 leading-relaxed font-light">
            Turnkey, manufacturer-direct solutions for schools, premium clubs, and professional academies across India.
          </p>
          
          <div class="flex gap-4">
            <a href="tel:+919821648112" class="bg-blue-600 hover:bg-blue-500 text-white px-8 py-4 rounded-full font-bold transition-all duration-300 shadow-lg shadow-blue-500/30 hover:-translate-y-1">
              Get a Free Quote
            </a>
            <a href="#details" class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-full font-bold backdrop-blur-md border border-white/20 transition-all duration-300">
              Explore Systems
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Glassmorphism Snapshot Hook -->
    <section class="relative z-20 -mt-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-20" id="details">
      <div class="ai-snapshot bg-white/80 backdrop-blur-xl border border-white/40 shadow-2xl rounded-2xl p-8 md:p-10 flex flex-col md:flex-row gap-8 items-center">
        <div class="flex-shrink-0 w-16 h-16 rounded-full bg-blue-100 flex items-center justify-center text-blue-600">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
        </div>
        <div>
          <h2 class="text-2xl font-bold text-slate-900 mb-3">What is the best synthetic court flooring?</h2>
          <p class="text-lg text-slate-600 leading-relaxed">
            Synthetic flooring offers UV stability, point-elastic shock absorption, and all-weather durability. UWIN Floortech provides <strong class="text-slate-800">ITF-certified acrylic</strong> and <strong class="text-slate-800">BWF-grade PVC vinyl</strong> surfaces engineered specifically to withstand the extreme temperature variations of the Indian climate.
          </p>
        </div>
      </div>
    </section>

    <!-- The Problem vs Solution Section -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-24">
      <div class="grid md:grid-cols-2 gap-16 items-center">
        <div>
          <h3 class="text-3xl font-bold text-slate-900 mb-6">The Shift to Synthetic Sports Surfaces in India</h3>
          <p class="text-lg text-slate-600 mb-6 leading-relaxed">
            Indian sports infrastructure is undergoing a massive upgrade cycle. The days of playing on raw asphalt or hard concrete are over. Modern institutions require certified surfaces that protect athletes and meet international federation standards.
          </p>
          <div class="bg-red-50 border-l-4 border-red-500 p-6 rounded-r-xl">
            <h4 class="font-bold text-red-900 mb-2">Why are schools replacing concrete courts?</h4>
            <p class="text-red-700">Bare concrete courts cause severe joint impact injuries, lower back strain, and shin splints. Synthetic court flooring—whether acrylic, PVC, or PP tiles—provides essential shock absorption, controlled slip resistance, and certified player safety.</p>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-6">
          <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 hover:shadow-md transition-shadow">
            <div class="text-blue-600 mb-4"><svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg></div>
            <h4 class="font-bold text-slate-900 mb-2">Shock Absorption</h4>
            <p class="text-sm text-slate-500">Reduces joint stress by up to 35% compared to raw concrete.</p>
          </div>
          <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 hover:shadow-md transition-shadow">
            <div class="text-blue-600 mb-4"><svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg></div>
            <h4 class="font-bold text-slate-900 mb-2">All-Weather</h4>
            <p class="text-sm text-slate-500">UV stabilized and highly resistant to monsoon pooling.</p>
          </div>
          <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 hover:shadow-md transition-shadow">
            <div class="text-blue-600 mb-4"><svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg></div>
            <h4 class="font-bold text-slate-900 mb-2">ITF & BWF Certified</h4>
            <p class="text-sm text-slate-500">Meets global tournament standards for pace and bounce.</p>
          </div>
          <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 hover:shadow-md transition-shadow">
            <div class="text-blue-600 mb-4"><svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg></div>
            <h4 class="font-bold text-slate-900 mb-2">High Durability</h4>
            <p class="text-sm text-slate-500">Engineered for 5-8 years of heavy commercial academy use.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Service Types Grid -->
    <section class="bg-slate-900 py-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-4xl font-bold text-white mb-4">Types of Synthetic Court Flooring</h2>
          <p class="text-xl text-slate-400 max-w-3xl mx-auto">We supply and install the three primary categories of synthetic sports surfaces, tailored for indoor and outdoor applications.</p>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
          <!-- Card 1 -->
          <div class="bg-slate-800 rounded-3xl p-8 hover:-translate-y-2 transition-transform duration-300 border border-slate-700">
            <div class="w-14 h-14 bg-blue-500/20 text-blue-400 rounded-2xl flex items-center justify-center mb-6">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.488 9H15V3.512A9.025 9.025 0 0120.488 9z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.512 15H9v5.488A9.025 9.025 0 013.512 15z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.512 9H9V3.512A9.025 9.025 0 003.512 9z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.488 15H15v5.488A9.025 9.025 0 0020.488 15z"></path></svg>
            </div>
            <h3 class="text-2xl font-bold text-white mb-4">Acrylic Court Coatings</h3>
            <p class="text-slate-400 mb-6">5-layer and 8-layer cushion systems. ITF-certified for tennis and basketball. Ideal for outdoor hard courts.</p>
            <a href="/products/acrylic-court-systems" class="text-blue-400 font-semibold hover:text-blue-300 inline-flex items-center">View System <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg></a>
          </div>

          <!-- Card 2 -->
          <div class="bg-slate-800 rounded-3xl p-8 hover:-translate-y-2 transition-transform duration-300 border border-slate-700">
            <div class="w-14 h-14 bg-emerald-500/20 text-emerald-400 rounded-2xl flex items-center justify-center mb-6">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path></svg>
            </div>
            <h3 class="text-2xl font-bold text-white mb-4">PVC Vinyl Sports Flooring</h3>
            <p class="text-slate-400 mb-6">High-density, multi-layer indoor flooring. BWF-compliant for badminton, table tennis, and indoor multi-sport halls.</p>
            <a href="/products/badminton-pvc-vinyl-sports-flooring" class="text-emerald-400 font-semibold hover:text-emerald-300 inline-flex items-center">View System <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg></a>
          </div>

          <!-- Card 3 -->
          <div class="bg-slate-800 rounded-3xl p-8 hover:-translate-y-2 transition-transform duration-300 border border-slate-700">
            <div class="w-14 h-14 bg-orange-500/20 text-orange-400 rounded-2xl flex items-center justify-center mb-6">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
            </div>
            <h3 class="text-2xl font-bold text-white mb-4">PP Interlocking Tiles</h3>
            <p class="text-slate-400 mb-6">UV-stabilized copolymer tiles. Excellent for fast outdoor retrofits over existing damaged concrete.</p>
            <a href="/products/pp-interlocking-tiles" class="text-orange-400 font-semibold hover:text-orange-300 inline-flex items-center">View System <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg></a>
          </div>
        </div>
      </div>
    </section>

    <!-- Sub-Base & Manufacturer Direct Section -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24">
      <div class="grid md:grid-cols-2 gap-16">
        <div>
          <h2 class="text-3xl font-bold text-slate-900 mb-6">Sub-Base Requirements</h2>
          <p class="text-lg text-slate-600 mb-8">No synthetic surface can compensate for a failing foundation. For a successful installation, the sub-base must be:</p>
          <ul class="space-y-4">
            <li class="flex items-start">
              <svg class="w-6 h-6 text-green-500 mr-3 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              <div>
                <strong class="text-slate-900 block">M20 Grade Concrete</strong>
                <span class="text-slate-600">Minimum compressive strength required to prevent base cracking under heavy load.</span>
              </div>
            </li>
            <li class="flex items-start">
              <svg class="w-6 h-6 text-green-500 mr-3 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              <div>
                <strong class="text-slate-900 block">200-Micron Moisture Barrier</strong>
                <span class="text-slate-600">Must be installed beneath the concrete to prevent rising dampness from delaminating the synthetic top coat.</span>
              </div>
            </li>
            <li class="flex items-start">
              <svg class="w-6 h-6 text-green-500 mr-3 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              <div>
                <strong class="text-slate-900 block">0.8% - 1% Slope for Drainage</strong>
                <span class="text-slate-600">Outdoor courts require a strict slope to ensure immediate rainwater runoff.</span>
              </div>
            </li>
          </ul>
        </div>
        
        <div class="bg-blue-600 rounded-3xl p-10 text-white shadow-2xl shadow-blue-600/20 flex flex-col justify-center">
          <h2 class="text-3xl font-bold mb-6">The UWIN Floortech Advantage</h2>
          <p class="text-blue-100 text-lg mb-6 leading-relaxed">
            Buying sports flooring in India usually involves navigating a maze of regional contractors and IndiaMART middlemen who mark up prices by 25-40% without adding installation value.
          </p>
          <p class="text-blue-100 text-lg mb-10 leading-relaxed">
            <strong>UWIN Floortech eliminates the middleman.</strong> We source ITF and BWF-grade materials directly from producers and install them with our own trained crews. You pay for the premium surface, not the trader's margin.
          </p>
          
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="tel:+919821648112" class="bg-white text-blue-900 px-8 py-4 rounded-full font-bold text-center hover:bg-slate-100 transition-colors shadow-lg">Call +91 98216 48112</a>
            <a href="https://wa.me/919821648112" target="_blank" rel="noopener" class="bg-[#25D366] text-white px-8 py-4 rounded-full font-bold text-center hover:bg-[#20bd5a] transition-colors shadow-lg flex items-center justify-center gap-2">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              WhatsApp Us
            </a>
          </div>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>
