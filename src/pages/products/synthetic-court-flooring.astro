242:   <!-- ============================================================
243:        TECHNICAL SPECIFICATIONS
244:        ============================================================ -->
245:   <section class="section section--white" aria-label="Sub-base requirements">
246:     <div class="container">
247:       <div class="section-header reveal">
248:         <h2 class="h2">Crucial Sub-Base Requirements</h2>
249:         <span class="section-divider" aria-hidden="true"></span>
250:         <p class="snapshot">No synthetic surface can compensate for a failing foundation. For a successful, long-lasting installation, the sub-base must be precisely engineered prior to applying the sports flooring.</p>
251:       </div>
252:       <div class="specs-table-wrap reveal">
253:         <table class="specs-table">
254:           <tbody>
255:             <tr>
256:               <td class="specs-table__key">M20 Grade Concrete</td>
257:               <td class="specs-table__val">Minimum compressive strength required to prevent base cracking under heavy load.</td>
258:             </tr>
259:             <tr>
260:               <td class="specs-table__key">Moisture Barrier</td>
261:               <td class="specs-table__val">A 200-micron vapor barrier must be installed beneath the concrete to prevent rising dampness from delaminating the synthetic top coat.</td>
262:             </tr>
263:             <tr>
264:               <td class="specs-table__key">Slope for Drainage</td>
265:               <td class="specs-table__val">Outdoor courts require a strict 0.8% to 1% slope to ensure immediate rainwater runoff.</td>
266:             </tr>
267:             <tr>
268:               <td class="specs-table__key">Curing Time</td>
269:               <td class="specs-table__val">New concrete must cure for a minimum of 21-28 days before acrylic or PVC installation.</td>
270:             </tr>
271:           </tbody>
272:         </table>
273:       </div>
274:     </div>
275:   </section>
