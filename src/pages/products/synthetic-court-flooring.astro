---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "Synthetic Court Flooring"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://uwinfloortech.com"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Products",
        "item": "https://uwinfloortech.com/products"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "Synthetic Court Flooring"
      }
    ]
  }
]);
---

<Layout title="Synthetic Court Flooring: Turnkey Solutions for Schools & Clubs | UWIN Floortech" description="Upgrade to certified synthetic court flooring. We provide manufacturer-direct PVC vinyl, acrylic, and PP tiles for sports facilities across India. Get a quote." schema={schema}>
  <Navbar />
  
  <!-- ============================================================
       PRODUCT HERO
       ============================================================ -->
  <section class="product-hero" aria-label="Synthetic Court Flooring hero">
    <div class="product-hero__img-wrap">
      <img src="/images/hero-synthetic-court.jpg" alt="High-end professional synthetic multi-sport court" class="product-hero__img" />
      <div class="product-hero__overlay"></div>
    </div>
    <div class="product-hero__content">
      <div class="product-hero__inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">›</span>
        <a href="/#products">Products</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">Synthetic Court Flooring</span>
      </nav>
      <span class="product-hero__eyebrow">Turnkey Sports Solutions</span>
      <h1 class="product-hero__title">Synthetic Court<br/>Flooring</h1>
      <p class="product-hero__sub">Turnkey, manufacturer-direct solutions for schools, premium clubs, and professional academies across India. We supply and install ITF-certified acrylic and BWF-grade PVC vinyl surfaces.</p>
      <div class="product-hero__ctas">
        <a href="/contact" class="btn btn-primary btn-lg">Get a Quote</a>
        <a href="https://wa.me/919821648112" target="_blank" rel="noopener" class="btn btn-whatsapp btn-lg">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          WhatsApp Inquiry
        </a>
      </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       QUICK SPEC BAR
       ============================================================ -->
  <div class="spec-bar">
    <div class="container spec-bar__inner">
      <div class="spec-bar__item">
        <span class="spec-bar__label">Materials</span>
        <span class="spec-bar__value">Acrylic, PVC Vinyl, PP Tiles</span>
      </div>
      <div class="spec-bar__item">
        <span class="spec-bar__label">Applications</span>
        <span class="spec-bar__value">Indoor & Outdoor Courts</span>
      </div>
      <div class="spec-bar__item">
        <span class="spec-bar__label">Certification</span>
        <span class="spec-bar__value">ITF & BWF Compliant</span>
      </div>
      <div class="spec-bar__item">
        <span class="spec-bar__label">Key Benefit</span>
        <span class="spec-bar__value">High Shock Absorption</span>
      </div>
    </div>
  </div>

  <!-- ============================================================
       OVERVIEW SECTION
       ============================================================ -->
  <section class="section section--white" aria-label="The Shift to Synthetic Sports Surfaces">
    <div class="container product-overview">
      <div class="product-overview__text">
        <span class="section-eyebrow">The Problem</span>
        <h2 class="h2">Why are schools and academies replacing raw concrete courts?</h2>
        <span class="section-divider" aria-hidden="true"></span>
        <p class="snapshot">Bare concrete courts cause severe joint impact injuries, lower back strain, and shin splints. Synthetic court flooring—whether acrylic, PVC, or PP tiles—provides essential point-elastic shock absorption, controlled slip resistance, and certified player safety engineered for the extreme temperature variations of the Indian climate.</p>
        <p>Indian sports infrastructure is undergoing a massive upgrade cycle. The days of playing on raw asphalt or hard concrete are over. Modern institutions require certified surfaces that protect athletes and meet international federation standards.</p>
        <div class="product-overview__tags" style="margin-top:1.5rem;">
          <span class="pac-tag">Reduces Joint Stress by 35%</span>
          <span class="pac-tag">UV & Weather Resistant</span>
          <span class="pac-tag">Federation Standard Pace</span>
        </div>
      </div>
      <div class="product-overview__img">
        <img src="/images/hero-synthetic-court.jpg" alt="Modern synthetic sports court showing vibrant lines" loading="lazy" style="border-radius:var(--card-radius); box-shadow:var(--shadow-md);" />
      </div>
    </div>
  </section>

  <!-- ============================================================
       TYPES OF FLOORING
       ============================================================ -->
  <section class="section section--surface" aria-label="Types of Synthetic Court Flooring">
    <div class="container">
      <div class="section-header reveal">
        <h2 class="h2">Types of Synthetic Court Flooring</h2>
        <span class="section-divider" aria-hidden="true"></span>
        <p class="snapshot">We supply and install the three primary categories of synthetic sports surfaces, tailored for indoor and outdoor applications across India. We offer manufacturer-direct pricing with absolutely zero middlemen margins.</p>
      </div>
      <div class="why-grid">
        <div class="why-card reveal">
          <div class="why-card__icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <h3 class="why-card__title">Acrylic Court Coatings</h3>
          <p>5-layer and 8-layer cushion systems. ITF-certified for tennis and basketball. Ideal for outdoor hard courts providing true ball bounce and UV resistance.</p>
          <a href="/products/acrylic-court-systems" style="color:var(--color-primary); font-weight:600; margin-top:1rem; display:inline-block;">Explore Acrylic Systems &rarr;</a>
        </div>
        <div class="why-card reveal reveal-delay-1">
          <div class="why-card__icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
          </div>
          <h3 class="why-card__title">PVC Vinyl Sports Flooring</h3>
          <p>High-density, multi-layer indoor flooring. BWF-compliant for badminton, table tennis, and indoor multi-sport halls. Incredible point-elastic shock absorption.</p>
          <a href="/products/badminton-pvc-vinyl-sports-flooring" style="color:var(--color-primary); font-weight:600; margin-top:1rem; display:inline-block;">Explore PVC Vinyl &rarr;</a>
        </div>
        <div class="why-card reveal reveal-delay-2">
          <div class="why-card__icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><line x1="22" y1="12" x2="2" y2="12"/><line x1="12" y1="22" x2="12" y2="2"/></svg>
          </div>
          <h3 class="why-card__title">PP Interlocking Tiles</h3>
          <p>UV-stabilized copolymer tiles. Excellent for fast outdoor retrofits over existing damaged concrete, providing a self-draining, all-weather playable surface.</p>
          <a href="/products/pp-interlocking-tiles" style="color:var(--color-primary); font-weight:600; margin-top:1rem; display:inline-block;">Explore PP Tiles &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       TECHNICAL SPECIFICATIONS
       ============================================================ -->
  <section class="section section--white" aria-label="Sub-base requirements">
    <div class="container">
      <div class="section-header reveal">
        <h2 class="h2">Crucial Sub-Base Requirements</h2>
        <span class="section-divider" aria-hidden="true"></span>
        <p class="snapshot">No synthetic surface can compensate for a failing foundation. For a successful, long-lasting installation, the sub-base must be precisely engineered prior to applying the sports flooring.</p>
      </div>
      <div class="specs-table-wrap reveal">
        <table class="specs-table">
          <tbody>
            <tr>
              <td class="specs-table__key">M20 Grade Concrete</td>
              <td class="specs-table__val">Minimum compressive strength required to prevent base cracking under heavy load.</td>
            </tr>
            <tr>
              <td class="specs-table__key">Moisture Barrier</td>
              <td class="specs-table__val">A 200-micron vapor barrier must be installed beneath the concrete to prevent rising dampness from delaminating the synthetic top coat.</td>
            </tr>
            <tr>
              <td class="specs-table__key">Slope for Drainage</td>
              <td class="specs-table__val">Outdoor courts require a strict 0.8% to 1% slope to ensure immediate rainwater runoff.</td>
            </tr>
            <tr>
              <td class="specs-table__key">Curing Time</td>
              <td class="specs-table__val">New concrete must cure for a minimum of 21-28 days before acrylic or PVC installation.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ============================================================
       CTA SECTION
       ============================================================ -->
  <section class="section section--cta" aria-label="The UWIN Advantage">
    <div class="container" style="text-align:center;">
      <h2 class="h2" style="color:#fff;">The UWIN Floortech Advantage</h2>
      <p style="color:rgba(255,255,255,0.8); max-width:600px; margin:1rem auto 2rem;">Buying sports flooring in India usually involves navigating a maze of middlemen who mark up prices by 25-40%. <strong>We eliminate the middleman.</strong> Get manufacturer-direct pricing and professional installation anywhere in India.</p>
      <div style="display:flex; gap:1rem; justify-content:center; flex-wrap:wrap;">
        <a href="/contact" class="btn btn-primary btn-lg" style="background:#fff; color:var(--color-primary);">Get a Free Quote</a>
        <a href="https://wa.me/919821648112" target="_blank" rel="noopener" class="btn btn-whatsapp btn-lg">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          WhatsApp Us Now
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
