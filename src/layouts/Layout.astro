---
import '../styles/styles.css';

export interface Props {
  title?: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  schema?: string;
}

const {
  title = "UWIN Floortech: Turnkey Sports Flooring Solutions | ITF Certified | India",
  description = "UWIN Floortech supplies and installs ITF-certified acrylic court coatings, UV-stabilised PP interlocking modular tiles, and EPDM rubberised athletic tracks with turnkey project execution. Serving schools, developers, sports clubs & government contractors across India.",
  ogTitle = "UWIN Floortech: Turnkey Sports Flooring Solutions",
  ogDescription = "Turnkey sports flooring solutions in India. ITF-certified acrylic courts, PP tiles, EPDM tracks. No middlemen. Competitive direct pricing.",
  schema
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="keywords" content="sports flooring supplier India, PP interlocking tiles, EPDM running track, acrylic court coating, ITF certified tennis court, turnkey sports flooring" />
  <meta property="og:title" content={ogTitle} />
  <meta property="og:description" content={ogDescription} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://uwinfloortech.com" />
  <link rel="icon" type="image/png" href="/favicon.png" />

  <!-- Preconnect fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <!-- JSON-LD Schema -->
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": ["ProfessionalService", "LocalBusiness"],
    "name": "UWIN Floortech",
    "url": "https://uwinfloortech.com",
    "description": "B2B turnkey supplier and installer of ITF-certified acrylic sports court coatings, UV-stabilised PP interlocking modular tiles, and EPDM rubberised athletic tracks.",
    "foundingDate": "2024",
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Sports Flooring Products",
      "itemListElement": [
        { "@type": "Offer", "itemOffered": { "@type": "Product", "name": "PP Interlocking Modular Sports Tiles" } },
        { "@type": "Offer", "itemOffered": { "@type": "Product", "name": "EPDM Rubberised Athletic Tracks" } },
        { "@type": "Offer", "itemOffered": { "@type": "Product", "name": "Acrylic Court Coating Systems" } }
      ]
    },
    "openingHours": "Mo-Sa 09:00-18:00",
    "areaServed": { "@type": "Country", "name": "India" }
  }
  </script>
  {schema && <script type="application/ld+json" is:inline set:html={schema}></script>}

  <!-- GSC Verification -->
  <meta name="google-site-verification" content="lqqqFqIvI5VR6Xhh51LUPRfdLCRXsMy0Y_SNiDtgP6U" />

  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-1CGWMQ69RC"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-1CGWMQ69RC');
  </script>
</head>
<body>
  <slot />

  <!-- ============================================================
